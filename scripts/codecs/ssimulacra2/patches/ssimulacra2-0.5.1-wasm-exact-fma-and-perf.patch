+        assert_eq!(output.len(), ROWS * width);
+
+        let mul_in = [
+            f32x4_splat(consts::MUL_IN_1),
+            f32x4_splat(consts::MUL_IN_3),
+            f32x4_splat(consts::MUL_IN_5),
+        ];
+        let mul_prev = [
+            f32x4_splat(consts::MUL_PREV_1),
+            f32x4_splat(consts::MUL_PREV_3),
+            f32x4_splat(consts::MUL_PREV_5),
+        ];
+        let mul_prev2 = [
+            f32x4_splat(consts::MUL_PREV2_1),
+            f32x4_splat(consts::MUL_PREV2_3),
+            f32x4_splat(consts::MUL_PREV2_5),
+        ];
+        let zero = f32x4_splat(0.0);
+        let mut prev = [[zero; ROW_QUADS]; 3];
+        let mut prev2 = [[zero; ROW_QUADS]; 3];
+
+        // Lanes 0..4 of quad `q` hold rows 4q..4q+4 of the block.
+        let gather = |x: usize, q: usize| -> v128 {
+            let r = 4 * q * width + x;
+            f32x4(input[r], input[r + width], input[r + 2 * width], input[r + 3 * width])
+        };
 
