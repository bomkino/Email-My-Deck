+        let mut n = (-big_n) + 1;
+        while n < width as isize {
+            let left = n - big_n - 1;
+            let right = n + big_n - 1;
+            for q in 0..ROW_QUADS {
+                let l = if left >= 0 { gather(left as usize, q) } else { zero };
+                let r = if right < width as isize { gather(right as usize, q) } else { zero };
+                let sum = f32x4_add(l, r);
+
+                let mut out = [zero; 3];
+                for k in 0..3 {
+                    let mut o = f32x4_mul(sum, mul_in[k]);
+                    o = f32x4_relaxed_madd(mul_prev2[k], prev2[k][q], o);
+                    prev2[k][q] = prev[k][q];
+                    o = f32x4_relaxed_madd(mul_prev[k], prev[k][q], o);
+                    prev[k][q] = o;
+                    out[k] = o;
+                }
+                if n >= 0 {
+                    let v = f32x4_add(f32x4_add(out[0], out[1]), out[2]);
