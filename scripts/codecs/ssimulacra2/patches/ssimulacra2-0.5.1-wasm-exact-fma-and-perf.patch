+                    output[o] = f32x4_extract_lane::<0>(v);
+                    output[o + width] = f32x4_extract_lane::<1>(v);
+                    output[o + 2 * width] = f32x4_extract_lane::<2>(v);
+                    output[o + 3 * width] = f32x4_extract_lane::<3>(v);
+                }
+            }
