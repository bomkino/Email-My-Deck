+/// `a.mul_add(b, c)` for the per-pixel f32 hot paths.
+///
+/// wasm32 has no fused multiply-add instruction, so `f32::mul_add` compiles to an
+/// out-of-line software `fmaf` call that dominates the run time and blocks
+/// vectorisation. On wasm32 we evaluate it in f64 instead: the f32 x f32 product
+/// is exact in f64, so the only difference from a true fused multiply-add is a
+/// possible double rounding in the final f64 -> f32 step, which only matters when
+/// the f64 sum lands exactly on an f32 rounding midpoint (vanishingly rare).
+/// Every other target keeps the original `mul_add`.
+#[inline(always)]
+pub(crate) fn mul_add_f32(a: f32, b: f32, c: f32) -> f32 {
+    #[cfg(target_arch = "wasm32")]
+    {
+        (f64::from(a) * f64::from(b) + f64::from(c)) as f32
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        a.mul_add(b, c)
+    }
+}
